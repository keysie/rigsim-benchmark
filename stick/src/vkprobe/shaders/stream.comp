#version 450
// read / write / copy over vec4 buffers, grid-stride
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint OP = 0;            // 0 read, 1 write, 2 copy
layout(std430, set = 0, binding = 0) buffer X { vec4 x[]; };
layout(std430, set = 0, binding = 1) buffer Y { vec4 y[]; };
layout(std430, set = 0, binding = 2) buffer O { float o[]; };
layout(push_constant) uniform P { uint n; uint a; uint b; uint c; } p;
void main() {
    uint stride = gl_NumWorkGroups.x * 256u;
    float acc = 0.0;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
        if (OP == 0u) { vec4 v = x[i]; acc += v.x + v.y + v.z + v.w; }
        else if (OP == 1u) { y[i] = vec4(1.0, 2.0, 3.0, float(i)); }
        else { y[i] = x[i]; }
    }
    if (OP == 0u && acc == 12345.678) o[0] = acc;     // keeps the loads, practically never stores
}
